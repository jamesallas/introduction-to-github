import cv2

# Load the face classifier
face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_frontalface_default.xml")

# Initialize camera
cap = cv2.VideoCapture(0)  # 0 refers to the default front camera

# Define a dictionary for manual labeling
known_faces = {
    "James Jared Allas": (100, 100, 200, 200),  # Example coordinates, update with real values
    "Joriz Chiong": (250, 150, 350, 250)  # Example coordinates
}

while True:
    ret, frame = cap.read()
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    
    # Detect faces
    faces = face_cascade.detectMultiScale(gray, 1.3, 5)
    
    for (x, y, w, h) in faces:
        cv2.rectangle(frame, (x, y), (x + w, y + h), (255, 0, 0), 2)

        # Label detected faces manually
        for name, (fx, fy, fw, fh) in known_faces.items():
            if abs(x - fx) < 50 and abs(y - fy) < 50:  # Adjust tolerance as needed
                cv2.putText(frame, name, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

    # Display the frame
    cv2.imshow("Face Detection", frame)

    # Exit on pressing 'q'
    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

# Release resources
cap.release()
cv2.destroyAllWindows()
